# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
PPROF_ENABLED=false

# PostgreSQL
POSTGRES_DSN=postgres://events:events@localhost:5432/events?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=5m

# ClickHouse
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=events
CLICKHOUSE_USER=events
CLICKHOUSE_PASSWORD=events

# Migration DSNs (used by cmd/migrate)
CLICKHOUSE_DSN=clickhouse://events:events@localhost:9000/events

# Kafka / Redpanda
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_EVENTS=events
KAFKA_TOPIC_RETRY=events.retry
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_CONSUMER_GROUP=event-processor
KAFKA_MAX_RETRIES=3

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=event-observability-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_TYPE=stdout

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Idempotency
IDEMPOTENCY_TTL=24h
